# Copy to ~/.config/pve-monitor/env on the host that runs pve-monitor, chmod
# 600, and fill in. Unlike hosts.env this file holds credentials, not just
# addresses.
#
# The API token is a copy, deliberately. Reading it out of a terraform working
# directory couples a monitor to a directory that gets destroyed.

# Proxmox API, and a token with read access to /cluster and /nodes.
export PVE_API_URL=https://proxmox-host:8006/api2/json
export PVE_TOKEN_ID=user@pam!token-name
export PVE_TOKEN_SECRET=

# Telegram bot from @BotFather, and the chat to post into. Get the chat id by
# messaging the bot once and reading message.chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
export TELEGRAM_BOT_TOKEN=
export TELEGRAM_CHAT_ID=

# PVE storage holding the backups, as named in the cluster's storage config.
export BACKUP_STORAGE=cluster_backup

# A backup older than this is reported. One missed run of a weekly job still
# leaves a guest inside the window.
export MAX_AGE_DAYS=9
