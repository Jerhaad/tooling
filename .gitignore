# Third-party binaries that happen to live in ~/bin. They are installs, not
# work, and terraform alone is 112 MB.
bin/helm
bin/terraform

# The filled-in copy of hosts.env.example. Belongs in ~/.config, never here.
hosts.env
*.env
!hosts.env.example

# Bytecode from lib/ and the test files that import it. Nothing here is run
# often enough for a stale cache to matter, and a lane's `add -A` will commit
# one otherwise.
__pycache__/
*.pyc
