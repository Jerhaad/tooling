#!/usr/bin/env python3
"""Grade open issues by how much work and how much context each one needs.

The point is routing, not estimation. An implement lane backed by a short
context window cannot hold an issue that has to be understood across several
subsystems, however small the edit turns out to be; a lane backed by a slow,
careful model is wasted on a one-line config change. Without a grade the lanes
race for whatever is top of the list and the smallest one draws work it cannot
hold.

Talks to the model directly rather than through an agent: this is a pure
classification with no tool use, and an agent loop per issue would spend more
time starting up than thinking. Requests are sequential because a single-slot
server gains nothing from concurrency -- raise --concurrency if yours has more.

Grades from the issue text alone, the way a human does at triage. That is a
hint, not a gate: an issue graded small that turns out large produces a run
with no commit, which the scheduling side already reports.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

# The grading model's endpoint belongs to whoever runs this. Same file the shell
# tools read, so one place names every host.
GRADER_URL = os.environ.get("GRADER_URL")
OUT = pathlib.Path(os.environ.get("GRADE_DIR", pathlib.Path.home() / "queue" / "size"))

# Anchored to one project so the grades mean the same thing run to run. An
# unanchored "small/medium/large" drifts every time the model is asked, which is
# why {project} is required rather than defaulted to something vague.
PROMPT = """Grade this GitHub issue for an implementation agent working on {project}.

Answer with exactly four lines and nothing else:

Size: XS|S|M|L
Context: low|medium|high
Files: <integer>
Reason: <one line, under 20 words>

Size is the edit itself:
  XS  one file, or a comment/config/doc change
  S   one migration plus threading a field through existing structs and queries
  M   a new endpoint, a new table with its repository layer, or a multi-crate change
  L   a new subsystem, a breaking contract change, or anything needing a design decision

Context is how much of the repository must be read to do it correctly:
  low     the issue names the files, or the change is local to one module
  medium  a few call sites must be found first
  high    the change depends on how several subsystems already fit together

Judge only from the text below. If the issue does not say enough to place it,
answer Size: L and Context: high, because an agent cannot safely guess either.

--- issue #{number}: {title} ---
{body}
"""

FIELDS = {
    "Size": re.compile(r"^\s*(?:\*\*)?Size(?:\*\*)?\s*:\s*(XS|S|M|L)\b", re.I | re.M),
    "Context": re.compile(r"^\s*(?:\*\*)?Context(?:\*\*)?\s*:\s*(low|medium|high)\b", re.I | re.M),
    "Files": re.compile(r"^\s*(?:\*\*)?Files(?:\*\*)?\s*:\s*(\d+)", re.I | re.M),
    "Reason": re.compile(r"^\s*(?:\*\*)?Reason(?:\*\*)?\s*:\s*(.+)$", re.I | re.M),
}


def route(size, context, lanes):
    """Which implement lane should take an issue of this shape.

    The two axes do not weigh the same, and that asymmetry is the whole rule.
    Context decides which lanes are eligible at all: a lane whose window cannot
    hold the reading is disqualified however small the edit is. Size only then
    chooses among what is left, because a slower and more careful model earns
    its time on judgement calls and wastes it on mechanical work.

    Lanes are tried in order and the first that admits both axes wins, so the
    most constrained lane belongs first in the config.
    """
    order = {"XS": 0, "S": 1, "M": 2, "L": 3}
    ctx_order = {"low": 0, "medium": 1, "high": 2}
    for lane in lanes:
        if (order[size] <= order[lane["max-size"]]
                and ctx_order[context] <= ctx_order[lane["max-context"]]):
            return lane["name"]
    # The last lane is the one with no ceiling; a config without one is a config
    # that can silently drop an issue.
    return lanes[-1]["name"] if lanes else "default"


def issues(repo):
    out = subprocess.run(
        ["gh", "issue", "list", "--repo", repo, "--state", "open", "--limit", "300",
         "--json", "number,title,body,updatedAt,labels"],
        capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def grade(issue, model, project, retries=2):
    body = (issue.get("body") or "").strip()[:6000]
    prompt = PROMPT.format(number=issue["number"], title=issue["title"],
                           body=body, project=project)
    payload = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 150,
        "temperature": 0,
        # Without this the model reasons before answering, and the reasoning
        # lands in `reasoning_content` while `content` comes back empty --
        # indistinguishable from a broken model unless you read the raw
        # response. It also spends roughly three times the tokens to reach the
        # same four lines. `/no_think` and `reasoning_effort` are ignored by
        # some llama.cpp builds; the template kwarg is the one that lands. A
        # server that rejects unknown kwargs needs it removed.
        "chat_template_kwargs": {"enable_thinking": False},
    }).encode()
    for attempt in range(retries + 1):
        try:
            req = urllib.request.Request(
                GRADER_URL, data=payload,
                headers={"Content-Type": "application/json"})
            text = json.loads(urllib.request.urlopen(req, timeout=300).read()
                              )["choices"][0]["message"]["content"]
        except (urllib.error.URLError, TimeoutError, KeyError) as e:
            if attempt == retries:
                return None, f"unreachable: {e}"
            time.sleep(5 * (attempt + 1))
            continue
        parsed = {k: (m.group(1).strip() if (m := rx.search(text)) else None)
                  for k, rx in FIELDS.items()}
        if parsed["Size"] and parsed["Context"]:
            parsed["Size"] = parsed["Size"].upper()
            parsed["Context"] = parsed["Context"].lower()
            return parsed, None
        if attempt == retries:
            return None, f"unparseable: {text.strip()[:120]!r}"
    return None, "exhausted"


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repo", default=os.environ.get("DEFAULT_GH_REPO"),
                    help="owner/name; defaults to $DEFAULT_GH_REPO, else the "
                         "current checkout's origin remote")
    ap.add_argument("--model", default=os.environ.get("GRADER_MODEL"),
                    help="model id to ask; defaults to $GRADER_MODEL")
    ap.add_argument("--project", default=os.environ.get("GRADE_PROJECT"),
                    help="one line describing the project, e.g. 'a Rust "
                         "workspace (axum API, sqlx/Postgres, a React SPA)'. "
                         "Anchors the grades so they mean the same thing run "
                         "to run; defaults to $GRADE_PROJECT")
    ap.add_argument("--lanes", default=os.environ.get("GRADE_LANES"),
                    help="implement lanes, most constrained first, as "
                         "name:max-size:max-context[,...] -- e.g. "
                         "'small:XS:low,fast:S:medium,default:L:high'. The "
                         "last lane should have no ceiling, or an issue that "
                         "exceeds every lane has nowhere to go; defaults to "
                         "$GRADE_LANES")
    ap.add_argument("--force", action="store_true",
                    help="re-grade issues whose grade is already current")
    ap.add_argument("--limit", type=int, default=0, help="grade at most N issues")
    args = ap.parse_args()
    if not GRADER_URL:
        sys.exit("set GRADER_URL to an OpenAI-compatible chat-completions endpoint")
    if not args.model:
        sys.exit("set --model or $GRADER_MODEL to the model id to grade with")
    if not args.project:
        sys.exit("set --project or $GRADE_PROJECT: an ungrounded grade drifts "
                 "every time the model is asked")
    if not args.lanes:
        sys.exit("set --lanes or $GRADE_LANES, e.g. "
                 "'small:XS:low,fast:S:medium,default:L:high'")
    lanes = []
    for spec in args.lanes.split(","):
        try:
            name, max_size, max_context = spec.strip().split(":")
        except ValueError:
            sys.exit(f"--lanes: {spec!r} is not name:max-size:max-context")
        if max_size not in ("XS", "S", "M", "L"):
            sys.exit(f"--lanes: {max_size!r} is not one of XS, S, M, L")
        if max_context not in ("low", "medium", "high"):
            sys.exit(f"--lanes: {max_context!r} is not one of low, medium, high")
        lanes.append({"name": name, "max-size": max_size, "max-context": max_context})
    if not args.repo:
        args.repo = subprocess.run(
            ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
            capture_output=True, text=True, check=True).stdout.strip()

    OUT.mkdir(parents=True, exist_ok=True)
    graded = skipped = failed = 0

    for issue in issues(args.repo):
        n = issue["number"]
        path = OUT / f"issue-{n}.json"
        # Re-grade only when the issue changed after it was last graded: the
        # text is the whole input, so an unchanged issue grades the same.
        if not args.force and path.exists():
            try:
                if json.loads(path.read_text()).get("updatedAt") == issue["updatedAt"]:
                    skipped += 1
                    continue
            except (json.JSONDecodeError, OSError):
                pass

        parsed, err = grade(issue, args.model, args.project)
        if err:
            print(f"#{n}: {err}", file=sys.stderr)
            failed += 1
            continue

        record = {
            "number": n,
            "title": issue["title"],
            "updatedAt": issue["updatedAt"],
            "labels": [lbl["name"] for lbl in issue.get("labels", [])],
            "size": parsed["Size"],
            "context": parsed["Context"],
            "files": int(parsed["Files"]) if parsed["Files"] else None,
            "reason": parsed["Reason"],
            "lane": route(parsed["Size"], parsed["Context"], lanes),
        }
        path.write_text(json.dumps(record, indent=2) + "\n")
        graded += 1
        print(f"#{n}: {record['size']}/{record['context']} -> {record['profile']}  {record['reason']}")
        if args.limit and graded >= args.limit:
            break

    # A closed issue is never iterated again, so its grade would otherwise sit
    # here forever and keep routing work that no longer exists.
    live = {i["number"] for i in issues(args.repo)}
    pruned = 0
    for stale in OUT.glob("issue-*.json"):
        if int(stale.stem.split("-")[1]) not in live:
            stale.unlink()
            pruned += 1

    print(f"\ngraded {graded}, unchanged {skipped}, failed {failed}, "
          f"pruned {pruned} -> {OUT}")
    return 1 if failed and not graded else 0


if __name__ == "__main__":
    sys.exit(main())
