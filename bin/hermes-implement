#!/usr/bin/env bash
# Hand a GitHub issue to the local Hermes agent's swe-updater skill.
#
# Hermes writes the change in a worktree this script does not create: the
# caller decides the branch point, so a failed run is thrown away by deleting
# the tree rather than by unwinding commits.
set -euo pipefail

HERMES=${HERMES_PYTHON:-${HERMES_HOME:-$HOME/.hermes}/hermes-agent/venv/bin/python}
TIMEOUT=${HERMES_IMPLEMENT_TIMEOUT:-5400}

usage() {
	cat <<'EOF'
usage: hermes-implement --issue N --worktree PATH [--repo OWNER/NAME]
                        [--verify CMD] [--extra TEXT] [--profile NAME]

--profile selects the agent profile, which chooses both the model and the host.
Your profiles are your own; `issue-grade --lanes` names the same set, and the
three shapes worth having are:

  (omitted)  The quality lane, and what unspecified work gets: correcting a bad
             diff costs more than the extra minutes a careful model spends.
  fast       A quicker model for small or mechanical work, where latency
             matters more than judgement.
  small      A short-context host for extra-small work. Also the only way to
             run a second stream, since a host serving one request at a time
             makes two runs queue rather than overlap.

--verify defaults to `gate-verify <worktree>`, which picks its gates from the
diff rather than from whoever wrote the dispatch.

Prints the transcript directory on stdout.
EOF
}

# Empty means the root profile, which is the dense 27B quality lane.
ISSUE="" WORKTREE="" REPO="" EXTRA="" VERIFY="" PROFILE=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	--issue) ISSUE="$2"; shift 2 ;;
	--worktree) WORKTREE="$2"; shift 2 ;;
	--repo) REPO="$2"; shift 2 ;;
	--verify) VERIFY="$2"; shift 2 ;;
	--extra) EXTRA="$2"; shift 2 ;;
	--profile) PROFILE="$2"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
	esac
done

# Chosen from the diff rather than by the caller. Picking a gate by hand is how
# a Helm template passed on Rust compiling and a misplaced --no-build reached
# CI: both times the gate was green and had not looked at the change.
: "${VERIFY:=gate-verify $WORKTREE}"

# -p rather than HERMES_PROFILE: the environment variable is read too late to
# pick the profile's model, so a run exported into it still talks to the default
# host.
PROFILE_ARGS=()
[[ -n "$PROFILE" ]] && PROFILE_ARGS=(-p "$PROFILE")
[[ -n "$ISSUE" && -n "$WORKTREE" ]] || { usage >&2; exit 2; }

cd "$WORKTREE"
BRANCH=$(git rev-parse --abbrev-ref HEAD)
WORK=$(mktemp -d -t hermes-implement-XXXXXX)

GH_ARGS=(issue view "$ISSUE")
[[ -n "$REPO" ]] && GH_ARGS+=(--repo "$REPO")
gh "${GH_ARGS[@]}" >"$WORK/issue.txt"

PROMPT=$(
	cat <<EOF
Implement one issue in the repository checked out at $WORKTREE.

Follow the swe-updater skill. The branch and worktree already exist: you are on
$BRANCH, based on the remote default branch. Skip the skill's ingest phase --
the work item is the issue below, not a REVIEW_NOTES.md file -- and do not
create, switch, or push any branch. Commit your work on $BRANCH and stop.

**Every file you write belongs to $WORKTREE.** Not only source files, and not
only git: nothing outside that directory is yours to change. Config files,
dotfiles, shared state, another worktree, anything under ~/.config or ~/.hermes
-- all off limits, even when changing one would make your task succeed. Other
work runs on this machine while you do, and a file outside your worktree is
something someone else is depending on right now.

**If a tool you need is broken, report it and stop. Do not repair it.** You may
be right about the cause: a previous run diagnosed a real bug in the
verification tooling correctly, wrote a workaround into a shared config file,
and carried on. That workaround changed the conditions of every other run on
this machine, hid the bug from the people who could fix it properly, and was
found days later by accident. A blocked task that reports why is a good
outcome. Put it in your handover and leave the environment as you found it.

That directory is also a git worktree of the same repository your project
settings point at, and it is not the same checkout. Editing the other one puts your
commit on a branch someone else is reading and leaves their checkout switched
underneath them. If a git command needs a repository, pass git's -C option and
this path. Do not cd elsewhere, and do not trust a remembered working directory
over this path.

The issue text is at $WORK/issue.txt. Read it in full before editing anything.

Verification command (the skill's Phase 4 -- run it yourself, read its output,
fix what it reports, and run it again until it passes):

    $VERIFY

$EXTRA

When you are done, write $WORK/HANDOVER.md: what you changed and why, what you
could not verify, and anything you deliberately left out.
EOF
)

BASE=$(git rev-parse HEAD)
# UTC, matching how hermes stamps last_edit_at, so the stray-write check below
# sees only this run.
START_ISO=$(date -u +%Y-%m-%dT%H:%M:%S)
ATTEMPTS=${HERMES_IMPLEMENT_ATTEMPTS:-4}

# A model that answers with prose instead of a tool call ends the run, so an
# abandoned task and a finished one both exit 0. The branch is the only
# trustworthy completion signal: keep resuming the session until it carries a
# commit that BASE did not.
run() {
	local label="$1" prompt="$2"
	shift 2
	set +e
	# --no-restore-cwd: a resumed session otherwise returns to the directory it
	# recorded, which for this agent is its bound project folder rather than the
	# worktree it was handed. It has committed in the wrong repository that way.
	timeout "$TIMEOUT" "$HERMES" -m hermes_cli.main ${PROFILE_ARGS[@]+"${PROFILE_ARGS[@]}"} "$@" --no-restore-cwd -z "$prompt" --skills swe-updater --yolo \
		>"$WORK/$label.stdout" 2>"$WORK/$label.stderr"
	local rc=$?
	set -e
	echo "$label: hermes exited $rc" >&2
	tail -3 "$WORK/$label.stdout" >&2
}

run attempt1 "$PROMPT"

# Resuming asks for the whole remaining task, never just the commit: a nudge
# that names committing as the goal gets an unverified commit, which is the one
# outcome worse than no commit at all -- it satisfies every check the caller can
# cheaply make.
REMAINING="The task is not finished. Resume it with tool calls, not with a plan.
It is done when '$VERIFY' has passed on the tree you are about to commit, that
commit is on $BRANCH, and $WORK/HANDOVER.md exists. Run the verification even if
you believe the code is correct: the last run of this task committed code that
did not compile."

for ((i = 2; i <= ATTEMPTS; i++)); do
	[[ "$(git rev-parse HEAD)" != "$BASE" ]] && break
	run "attempt$i" "$REMAINING" --continue
done

if [[ "$(git rev-parse HEAD)" == "$BASE" ]]; then
	echo "FAILED: $ATTEMPTS attempts left $BRANCH at $BASE" >&2
elif [[ ! -s "$WORK/HANDOVER.md" ]]; then
	echo "WARNING: $BRANCH has a commit but no handover was written" >&2
fi

# What the run actually wrote, which the handover is not a complete account of:
# one lane created and deleted a scratch file its handover never mentioned, and
# another edited a shared config file while reporting only its issue. hermes
# records every edited path per session here, so this is the only place the
# question can be answered after the fact.
EVIDENCE=${HERMES_HOME:-$HOME/.hermes}
[[ -n "$PROFILE" ]] && EVIDENCE="$EVIDENCE/profiles/$PROFILE"
EVIDENCE="$EVIDENCE/verification_evidence.db"
if [[ -r "$EVIDENCE" ]]; then
	python3 - "$EVIDENCE" "$WORKTREE" "$START_ISO" <<'PYEOF' >&2 || true
import json, sqlite3, sys
db, worktree, since = sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3]
try:
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    rows = c.execute(
        "select session_id, changed_paths_json from verification_state"
        " where root = ? and last_edit_at >= ?", (worktree, since)).fetchall()
except sqlite3.Error:
    sys.exit(0)
stray = sorted({p for _, j in rows for p in json.loads(j or "[]")
                if not p.startswith(worktree + "/")})
if stray:
    print(f"WARNING: this run wrote {len(stray)} path(s) outside {worktree}:")
    for p in stray:
        print(f"  {p}")
    print("  A lane may only write inside its worktree. Review before trusting"
          " this run, and before trusting anything else that reads those paths.")
PYEOF
fi

echo "$WORK"
