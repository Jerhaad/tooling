#!/usr/bin/env bash
# Show whether an index is usable by a query, and whether the planner picks it.
#
# Two plans, because they answer different questions. With sequential scans
# allowed, the planner shows what it would really do. With them disabled, it
# shows whether the index *can* serve the query at all -- a plan that still
# sequentially scans under `enable_seqscan = off` is the planner saying the
# index is unusable for that shape, not merely unattractive.
#
# That distinction is why this exists. A GIN index was added alongside a
# `labels->>'k' = 'v'` filter, which only containment can use; a B-tree was
# added for a query that groups the whole table. Both cost every insert and
# neither was ever chosen, and nothing in the test suite or the compiler
# disagreed with the comment claiming otherwise.
#
# Seed first. An empty table is sequentially scanned whatever indexes exist, so
# an unseeded EXPLAIN says nothing at all.
set -euo pipefail

# readlink -f, not `cd -P`: these are installed as symlinks into a bin
# directory on PATH, and BASH_SOURCE holds the symlink's own path. `cd -P`
# resolves symlinks inside the path it is given, not the script's location, so
# ../lib resolved against the link and landed outside the checkout.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

usage() {
	cat <<'EOF'
usage: pg-explain <worktree> [--seed FILE.sql] [--analyze] [SQL]

Reads SQL from the last argument or stdin. Applies the worktree's migrations to
a per-worktree database first, so the schema matches the branch. The database,
its container and the migration directory come from gates.toml's `bench` task.

  --seed FILE   run FILE.sql before explaining; without rows every plan is a
                sequential scan and the output is meaningless
  --analyze     actually execute, reporting real timings and trigger costs
EOF
	exit 2
}

[ $# -ge 1 ] || usage
SRC=$(repo_root "$1")
shift

SEED="" ANALYZE=""
while [ $# -gt 0 ]; do
	case "$1" in
	--seed) SEED="$2"; shift 2 ;;
	--analyze) ANALYZE="ANALYZE, TIMING OFF, SUMMARY ON,"; shift ;;
	-h | --help) usage ;;
	*) break ;;
	esac
done

SQL=${1:-$(cat)}
[ -n "$SQL" ] || { echo "no SQL given" >&2; usage; }

NAME=$(tree_name "$SRC")
DB="explain_$NAME"

# The same builder, container and role the bench task uses: a plan is only
# meaningful against the postgres version the project actually runs.
eval "$(python3 "$LIB/manifest.py" "$SRC" --task bench)"
REMOTE=$(host_for "$TASK_ROLE")
DB_CONTAINER=$TASK_DB_CONTAINER
DB_USER=$TASK_DB_USER
MIGRATIONS=$(manifest "$SRC" bench.migrations migrations)
DEST="explain/$NAME"

ssh "$REMOTE" "mkdir -p $DEST"
rsync -a --delete "$SRC/$MIGRATIONS/" "$REMOTE:$DEST/migrations/"
[ -n "$SEED" ] && scp -q "$SEED" "$REMOTE:$DEST/seed.sql"

# Rebuilt every run: a database carrying the previous branch's schema answers
# confidently about an index that no longer exists.
ssh "$REMOTE" "docker exec -i $DB_CONTAINER psql -U $DB_USER -d postgres -q -v ON_ERROR_STOP=1 \
	-c 'DROP DATABASE IF EXISTS $DB WITH (FORCE)' -c 'CREATE DATABASE $DB'"

ssh "$REMOTE" "bash -euo pipefail -s" <<REMOTE_SCRIPT
cd $DEST
for m in migrations/*.sql; do
	docker exec -i $DB_CONTAINER psql -U $DB_USER -d $DB -q -v ON_ERROR_STOP=1 -f - < "\$m"
done
$([ -n "$SEED" ] && echo "docker exec -i $DB_CONTAINER psql -U $DB_USER -d $DB -q -v ON_ERROR_STOP=1 -f - < seed.sql")
# </dev/null on every psql that reads no file: `docker exec -i` otherwise
# inherits this script's stdin, which is the heredoc feeding it, and swallows
# every remaining line -- the EXPLAINs included.
docker exec -i $DB_CONTAINER psql -U $DB_USER -d $DB -q -c 'ANALYZE' >/dev/null </dev/null

echo '=== plan as the planner chooses it ==='
docker exec -i $DB_CONTAINER psql -U $DB_USER -d $DB -X -q -c "EXPLAIN ($ANALYZE COSTS OFF) $SQL" </dev/null

echo '=== plan with sequential scans disabled (is any index usable at all?) ==='
docker exec -i $DB_CONTAINER psql -U $DB_USER -d $DB -X -q \
	-c 'SET enable_seqscan = off' -c "EXPLAIN ($ANALYZE COSTS OFF) $SQL" </dev/null
REMOTE_SCRIPT

cat <<'NOTE'

A sequential scan in the second plan means no index can serve this query --
adding one costs writes and changes nothing. An index scan there but not in the
first means the index works and the planner judged it not worth using, which on
a seeded table usually means the query is not selective enough to matter.
NOTE
