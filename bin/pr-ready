#!/usr/bin/env bash
# Take a pull request out of draft, and refuse when the agent work behind it is
# not finished.
#
# Draft is the interlock: a PR stays draft for as long as an agent is still
# working it, so nobody can merge a branch whose findings are still open. That
# only holds if leaving draft is a checked transition rather than a habit --
# `gh pr ready` on its own will happily promote a branch with a dirty worktree,
# unpushed commits, or a review finding nobody fixed.
#
# Every check here has let a bad branch through at least once:
#   - a lane committed, then regenerated the .sqlx cache, and left it dirty; the
#     bench passed because it reads the working tree and CI reads the commit
#   - a rebase resolved a table-count assertion to a value that was correct when
#     it was written and stale by the time it merged
#   - two PRs edited the same assertion to the same number, so git merged them
#     without a conflict into a value that was wrong for both
set -euo pipefail

usage() {
	cat <<'EOF'
usage: pr-ready <PR> [worktree] [--check] [--no-verify] [--no-condense]

Marks PR ready for review, but only if all of these hold:

  - the PR is open and currently a draft
  - the worktree is clean (nothing uncommitted)
  - local HEAD matches the PR's pushed head (nothing unpushed)
  - GitHub reports the PR mergeable, not conflicting
  - every CI check has finished and passed
  - gate-verify passes on the worktree
  - condense-prose flags nothing in the diff

--check reports the verdict and changes nothing; exit 1 if it would refuse.
--no-verify skips the gate-verify run when CI has already covered it. It does
not skip anything else.
--no-condense skips the condense-prose pass, for prose you have read and kept.

worktree defaults to the current directory.
EOF
	exit 2
}

[ $# -ge 1 ] || usage
PR="$1"; shift
[[ "$PR" =~ ^[0-9]+$ ]] || usage

WORKTREE="" CHECK=0 VERIFY=1 CONDENSE=1
BASE_REF=${PR_READY_BASE:-origin/main}
FIND_PROSE=${CONDENSE_PROSE:-$HOME/.claude/skills/condense-prose/find_prose.py}
while [ $# -gt 0 ]; do
	case "$1" in
	--check) CHECK=1; shift ;;
	--no-verify) VERIFY=0; shift ;;
	--no-condense) CONDENSE=0; shift ;;
	-h | --help) usage ;;
	*) [ -z "$WORKTREE" ] || usage; WORKTREE="$1"; shift ;;
	esac
done
SRC=$(cd "${WORKTREE:-$PWD}" && git rev-parse --show-toplevel)
# Everything below asks a question about that worktree: gh resolves the
# repository from the directory it runs in, and the prose finder resolves --diff
# the same way. Standing anywhere else silently asks about another repository.
cd "$SRC"

FAILED=()
refuse() { FAILED+=("$1"); }

read -r STATE IS_DRAFT HEAD_BRANCH HEAD_OID MERGEABLE < <(
	gh pr view "$PR" --json state,isDraft,headRefName,headRefOid,mergeable \
		--jq '[.state, (.isDraft|tostring), .headRefName, .headRefOid, .mergeable] | @tsv'
)

[ "$STATE" = "OPEN" ] || refuse "PR is $STATE, not OPEN"
# Already-ready is not an error: re-running after a fix should be a no-op rather
# than something the caller has to special-case.
[ "$IS_DRAFT" = "true" ] || echo "note: PR $PR is already ready for review" >&2
[ "$MERGEABLE" != "CONFLICTING" ] || refuse "GitHub reports the branch conflicting with its base"

# The branch this checkout is on has to be the branch the PR is about, or every
# check below is measuring something else.
LOCAL_BRANCH=$(git -C "$SRC" rev-parse --abbrev-ref HEAD)
[ "$LOCAL_BRANCH" = "$HEAD_BRANCH" ] ||
	refuse "worktree is on $LOCAL_BRANCH, PR $PR is $HEAD_BRANCH"

# A dirty tree means the thing that was verified is not the thing that will be
# reviewed. The .sqlx cache is the recurring case: it is regenerated by a
# separate command, so it is the file most likely to be left behind.
[ -z "$(git -C "$SRC" status --porcelain)" ] ||
	refuse "worktree has uncommitted changes: $(git -C "$SRC" status --porcelain | wc -l) path(s)"

LOCAL_OID=$(git -C "$SRC" rev-parse HEAD)
[ "$LOCAL_OID" = "$HEAD_OID" ] ||
	refuse "local HEAD ${LOCAL_OID:0:7} is not the pushed head ${HEAD_OID:0:7}"

# `gh pr checks` exits non-zero for both "failing" and "still running", which are
# different answers to this question, so read the buckets rather than the code.
CHECKS=$(gh pr checks "$PR" --json name,bucket 2>/dev/null || echo '[]')
PENDING=$(jq -r '[.[] | select(.bucket=="pending")] | length' <<<"$CHECKS")
BAD=$(jq -r '[.[] | select(.bucket!="pass" and .bucket!="skipping" and .bucket!="pending")] | .[].name' <<<"$CHECKS")
TOTAL=$(jq -r 'length' <<<"$CHECKS")

[ "$TOTAL" -gt 0 ] || refuse "no CI checks reported for this head -- has it been pushed?"
[ "$PENDING" -eq 0 ] || refuse "$PENDING CI check(s) still running"
[ -z "$BAD" ] || refuse "CI check(s) not passing: $(tr '\n' ' ' <<<"$BAD")"

report() {
	echo "refusing to mark PR $PR ready:" >&2
	printf '  - %s\n' "${FAILED[@]}" >&2
	exit 1
}

# Everything above is a metadata read costing a second or two, so they all run
# and one invocation names every reason. gate-verify costs minutes and builds
# on a host other branches are queued against, so it runs only once the cheap
# answers are all yes.
[ ${#FAILED[@]} -eq 0 ] || report

if [ "$VERIFY" -eq 1 ]; then
	echo "==> gate-verify $SRC" >&2
	gate-verify "$SRC" >&2 || refuse "gate-verify failed"
	[ ${#FAILED[@]} -eq 0 ] || report
fi

# Last, because it is the only step asking about the writing rather than the
# code, and the writing is what a reviewer meets first. Its own exit status is
# always 0 -- the skill's position is that a finding is a question, not a
# failure -- so the refusal is this script's, and answering "I looked and I am
# keeping it" is what --no-condense is for.
if [ "$CONDENSE" -eq 1 ]; then
	if [ -x "$FIND_PROSE" ]; then
		echo "==> condense-prose" >&2
		FLAGGED=$("$FIND_PROSE" --diff "$BASE_REF" --json 2>/dev/null | jq 'length')
		if [ "${FLAGGED:-0}" -gt 0 ]; then
			"$FIND_PROSE" --diff "$BASE_REF" >&2 || true
			refuse "condense-prose flagged $FLAGGED block(s); cut them or pass --no-condense"
			report
		fi
	else
		echo "note: condense-prose not installed at $FIND_PROSE, skipping" >&2
	fi
fi

if [ "$CHECK" -eq 1 ]; then
	echo "PR $PR would be marked ready"
	exit 0
fi

[ "$IS_DRAFT" = "true" ] || exit 0
gh pr ready "$PR"
