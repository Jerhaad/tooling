#!/usr/bin/env bash
# Run the gates that can see what a branch actually changed.
#
# Choosing the gate by hand is where this goes wrong. A Helm template reached
# main because the Rust bench approved it; a misplaced `--no-build` reached CI
# because the compose check ran its own spelling of the command. Both times the
# gate was green and blind. Deriving the gate list from the diff removes the
# choice.
#
# Runs every applicable gate rather than stopping at the first failure, so one
# run reports everything wrong with the branch.
set -euo pipefail

BASE=${HYPATIA_VERIFY_BASE:-origin/main}

usage() { echo "usage: hypatia-verify <worktree> [--no-prove] [--list]" >&2; exit 2; }
[ $# -ge 1 ] || usage
SRC=$(cd "$1" && git rev-parse --show-toplevel)
shift
PROVE=1 LIST=0
while [ $# -gt 0 ]; do
	case "$1" in
	--no-prove) PROVE=0; shift ;;
	--list) LIST=1; shift ;;
	*) usage ;;
	esac
done

cd "$SRC"
mapfile -t CHANGED < <(git diff --name-only "$BASE"...HEAD)
[ ${#CHANGED[@]} -gt 0 ] || { echo "no changes against $BASE" >&2; exit 2; }

changed() { printf '%s\n' "${CHANGED[@]}" | grep -qE "$1"; }

GATES=() NAMES=()
add() { NAMES+=("$1"); GATES+=("$2"); }

# Rust, SQL and the image build. --full whenever SQL or a Dockerfile moved,
# because sqlfluff and the image build only run under it and both have caught
# things the plain bench did not.
if changed '^(crates/|Cargo\.(toml|lock)$|migrations/|\.sqlx/)'; then
	if changed '^(migrations/|docker/Dockerfile)'; then
		add "bench --full" "hypatia-bench --full $SRC"
	else
		add "bench" "hypatia-bench $SRC"
	fi
fi

# The chart, through the repository's own script rather than a copy of it --
# and also when that script itself changes, since nothing else exercises it.
changed '^(deploy/charts/|scripts/helm-chart-check\.sh$)' &&
	add "chart" "hypatia-chart-check $SRC"

# Terraform, through the repository's own script -- and when that script itself
# changes, since nothing else exercises it.
changed '^(deploy/terraform/|scripts/terraform-check\.sh$)' &&
	add "terraform" "hypatia-tf-check $SRC"

# The compose migrate path, running the command read out of ci.yaml.
changed '^(docker/docker-compose|\.github/workflows/ci\.yaml)' &&
	add "compose" "hypatia-compose-check $SRC"

# The SPA. Type errors are invisible to vitest, which strips types rather than
# checking them, so both run.
if changed '^web/'; then
	add "web types" "sh -c 'cd $SRC/web && npx tsc --noEmit'"
	add "web tests" "sh -c 'cd $SRC/web && npx vitest run'"
fi

# Cheap and independent of the language, so it runs on every branch.
add "artifacts" "hypatia-artifact-check $SRC"

# New API surface with no test touched anywhere. #174 added a table, a
# repository, three routes and a model in 537 lines, went green on `bench
# --full` and compose, and was verified to compile, migrate and build an image
# -- never to behave, because `prove` only runs when a test file moved. A gate
# that stays quiet about that is agreeing the surface is covered.
if changed '^crates/(db/src/repo/|api-rest/src/routes/)' && ! changed '(/tests/.*\.rs$|^tests/.*\.rs$)'; then
	add "untested surface" "sh -c 'echo \"repository or route code changed and no test file did.\" >&2; echo \"Add the test, or rerun with HYPATIA_ALLOW_UNTESTED=1 to say why not.\" >&2; [ -n \"\${HYPATIA_ALLOW_UNTESTED:-}\" ]'"
fi

# A test that passes without the change is not a test. Last, because it is the
# slowest and the least useful to see first.
if [ "$PROVE" = 1 ] && changed '(/tests/.*\.rs$|^tests/.*\.rs$)'; then
	add "prove" "hypatia-prove $SRC"
fi

if [ ${#GATES[@]} -eq 0 ]; then
	echo "no gate matches the changed paths:" >&2
	printf '  %s\n' "${CHANGED[@]}" >&2
	echo "Add one to hypatia-verify rather than shipping unverified." >&2
	exit 1
fi

printf '==> %d file(s) changed; running: %s\n\n' "${#CHANGED[@]}" "$(IFS=, ; echo "${NAMES[*]}")"

if [ "$LIST" = 1 ]; then
	for i in "${!GATES[@]}"; do printf '  %-12s %s\n' "${NAMES[$i]}" "${GATES[$i]}"; done
	exit 0
fi

failed=() unprovable=()
for i in "${!GATES[@]}"; do
	echo "########## ${NAMES[$i]} ##########"
	set +e
	eval "${GATES[$i]}"
	rc=$?
	set -e
	# 3 is a gate saying it could not answer, which is neither a pass nor a
	# failure. Reported on its own line so it cannot be read as either: a gate
	# that gathered no evidence must not appear in a list headed "passed".
	if [ $rc -eq 3 ]; then
		unprovable+=("${NAMES[$i]}")
	elif [ $rc -ne 0 ]; then
		failed+=("${NAMES[$i]}")
	fi
	echo
done

if [ ${#failed[@]} -gt 0 ]; then
	printf '==> FAILED: %s\n' "$(IFS=, ; echo "${failed[*]}")" >&2
	[ ${#unprovable[@]} -gt 0 ] && printf '==> UNPROVABLE: %s\n' "$(IFS=, ; echo "${unprovable[*]}")" >&2
	exit 1
fi
if [ ${#unprovable[@]} -gt 0 ]; then
	printf '==> UNPROVABLE: %s\n' "$(IFS=, ; echo "${unprovable[*]}")" >&2
	passed=()
	for n in "${NAMES[@]}"; do
		skip=0
		for u in "${unprovable[@]}"; do [ "$n" = "$u" ] && skip=1; done
		[ $skip -eq 0 ] && passed+=("$n")
	done
	[ ${#passed[@]} -gt 0 ] && echo "==> gates passed: $(IFS=, ; echo "${passed[*]}")"
	exit 0
fi
echo "==> all gates passed: $(IFS=, ; echo "${NAMES[*]}")"
