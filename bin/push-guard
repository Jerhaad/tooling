#!/usr/bin/env bash
# Git pre-push hook: refuse a push that would delete files main added after
# the branch's previous push.
#
# The bug this answers (issue #68): a squash that resets onto origin/main
# while index still holds the pre-squash tree records a commit whose parent
# is the new main, so its diff deletes everything main merged since the
# branch's fork. Nothing between the squash and the push can see the loss:
# deletions are off the prose and redaction passes' scope by design,
# remote-task is pre-squash, and pr-ready never runs because the PR was
# never a draft.
#
# The check fires at push time, not at promotion, because promotion never
# ran for the bad PR. A pre-push hook is what runs on every push, and the
# rule is local enough to live in one tool.
#
# The rule, for each pushed branch ref:
#   - skip ref deletions (local sha is all zeros)
#   - skip pushes of main itself
#   - skip new branches (remote sha is all zeros; nothing to compare)
#   - skip, with a one-line note on stderr, when the remote sha is absent
#     locally (the previous push has not been fetched)
#   - base = refs/remotes/<remote>/<PUSH_GUARD_BASE:main>
#     Do not fetch: the hook judges against what this checkout currently
#     believes main is, which is exactly what moved in the issue.
#   - deleted = paths the PR would delete vs the merge base of base and
#     the pushed commit
#   - gained = paths main added in commits between the branch's previously
#     pushed head and base
#   - if deleted and gained intersect, print them, explain that main added
#     them after the branch's last push and that this push deletes them,
#     and say how to acknowledge it (PUSH_GUARD_ACK=1); exit 1. With the
#     ack variable set, print the same list as a warning and exit 0.
#
# Install by pointing a repository's hooksPath at this checkout's
# `hooks/` directory:
#
#   git config core.hooksPath /path/to/agent-tools/hooks
#
# PUSH_GUARD_BASE overrides the branch whose additions the guard checks
# against (default: main). PUSH_GUARD_ACK=1 turns a refusal into a
# warning.
set -euo pipefail

REMOTE=${1:-}
# Resolve our checkout the same way other bin/ tools resolve ../lib:
# readlink -f, not `cd -P`, so a symlinked install lands on the real
# checkout rather than the link's parent.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

BASE_BRANCH=${PUSH_GUARD_BASE:-main}

note() { echo "push-guard: $*" >&2; }

if [ -z "$REMOTE" ]; then
	note "missing remote name (first arg); skipping"
	exit 0
fi

BASE=refs/remotes/$REMOTE/$BASE_BRANCH

# Fail loud if base ref is gone locally -- the variable name ($BASE_BRANCH)
# is the only thing the operator configured, and an unset override is the
# most likely reason the ref is missing. We are not silent.
if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
	note "no local tracking ref for $BASE; skipping"
	exit 0
fi

ZERO=0000000000000000000000000000000000000000
FAIL=0
ANY_REF=0

# Each line on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
	# Tolerate blank or whitespace-only lines without tripping set -e.
	[ -z "${local_ref:-}" ] && continue
	ANY_REF=1

	# Skip ref deletions: local sha is all zeros.
	if [ "$local_sha" = "$ZERO" ]; then
		continue
	fi

	# Only branches. Tags use refs/tags/* and should not go through
	# the deleted/gained intersection check.
	case "$local_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	# Skip pushes of main itself (or whatever BASE_BRANCH is). main's
	# deletion of a file it owned two commits ago is just history.
	if [ "$local_ref" = "refs/heads/$BASE_BRANCH" ]; then
		continue
	fi

	# Skip new branches: with no previous push, there is nothing to
	# compare against.
	if [ "$remote_sha" = "$ZERO" ]; then
		continue
	fi

	# The remote's last-pushed sha may not be in the local object
	# store yet (the working checkout never fetched it). When that
	# happens we cannot compute gained; silently passing is worse
	# than saying so.
	if ! git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
		note "$local_ref: remote sha $remote_sha not found locally; fetching would let the check run"
		continue
	fi

	local_sha=$(git rev-parse --verify "$local_sha^{commit}")
	remote_sha=$(git rev-parse --verify "$remote_sha^{commit}")
	base_sha=$(git rev-parse --verify "$BASE")

	if ! merge_base=$(git merge-base "$base_sha" "$local_sha"); then
		note "$local_ref: no common ancestor with $BASE; skipping"
		continue
	fi
	# deleted: paths this push would remove against the merge base of
	# base and the pushed commit. merge-base is the branch's fork point,
	# which is the correct anchor for "what the PR changes".
	deleted=$(git diff --name-only --diff-filter=D "$merge_base" "$local_sha")
	# gained: paths main added between the branch's previously pushed
	# head and base. This is what a stale-base squash would clobber.
	gained=$(git log --format= --name-only --diff-filter=A "$remote_sha".."$base_sha")

	if [ -z "$deleted" ] || [ -z "$gained" ]; then
		continue
	fi

	# Intersection via comm, available everywhere git ships.
	intersection=$(printf '%s\n%s\n' "$deleted" "$gained" \
		| sort | uniq -d)
	if [ -z "$intersection" ]; then
		continue
	fi

	note "$local_ref would delete paths main added after the branch's last push:"
	printf '  %s\n' $intersection >&2
	note "main added these commits after the branch's previous push; the push would re-delete them."
	if [ "${PUSH_GUARD_ACK:-0}" = "1" ]; then
		note "PUSH_GUARD_ACK=1: acknowledging and pushing anyway."
	else
		note "acknowledge by re-running with PUSH_GUARD_ACK=1, or rebase the branch onto the current $BASE_BRANCH."
		FAIL=1
	fi
done

# Some `git push` invocations send no lines at all (e.g. dry-run edge cases).
# Skipping with no input is the right behaviour, not an error.
[ "$ANY_REF" -eq 1 ] || exit 0
exit "$FAIL"
