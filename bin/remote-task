#!/usr/bin/env bash
# Run one of the project's own commands on a host that has the toolchain.
#
# What this owns: moving the tree, serialising runs that share a build cache,
# handing the command a database of its own, and copying back what the build
# resolved remotely. What the command does is the project's business -- it is
# read from gates.toml so that it cannot drift from the one CI runs.
#
# Every task shares one remote directory per tree, so a warm build cache is
# reused rather than synced twice, and they take one lock for the same reason.
#
# Each source tree gets its own remote directory, so a build cache survives
# between runs, and its own database, so a branch never inherits the schema of
# the branch before it.
set -euo pipefail

TASK=bench NAME=unknown REMOTE_TASK_DONE=0
# Installed before setup so every failure ends in one verdict. A signal-killed
# run reaches this trap with $? still 0, so PASS also needs REMOTE_TASK_DONE,
# set by the script's last line. An INT/TERM trap would not help: bash defers
# it until the foreground ssh returns, holding a killed run open.
#
# `timeout` reaches us with exit 124 (its documented timeout status).
verdict() {
	local status=$?
	trap - EXIT
	if [ "$status" -eq 0 ] && [ "$REMOTE_TASK_DONE" = 1 ]; then
		printf '==> PASS (%s: %s)\n' "$TASK" "$NAME" || :
	else
		local reason
		if [ -n "${FAIL_REASON:-}" ]; then
			reason=$FAIL_REASON
		elif [ "$status" -eq 124 ]; then
			reason="timed out after ${TASK_TIMEOUT}s"
		elif [ "$status" -eq 75 ]; then
			reason="timed out after ${LOCK_WAIT}s waiting on the remote bench lock"
		elif [ "$status" -eq 0 ]; then reason=interrupted; else reason="exit $status"; fi
		printf '==> FAIL (%s: %s, %s)\n' "$TASK" "$NAME" "$reason" || :
		[ "$status" -ne 0 ] || status=1
	fi
	exit "$status"
}
trap verdict EXIT

# readlink -f, not `cd -P`: these are installed as symlinks into a bin
# directory on PATH, and BASH_SOURCE holds the symlink's own path. `cd -P`
# resolves symlinks inside the path it is given, not the script's location, so
# ../lib resolved against the link and landed outside the checkout.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

# Both flock wait timeouts share this override.
LOCK_WAIT=${REMOTE_TASK_LOCK_WAIT:-7200}

usage() { echo "usage: remote-task [--task NAME] [--full] [worktree]" >&2; exit 2; }

TASK=bench FULL=0
ARGS=()
while [ $# -gt 0 ]; do
	case "$1" in
	--task) [ $# -ge 2 ] || usage; TASK=$2; shift 2 ;;
	--full) FULL=1; shift ;;
	-h | --help) usage ;;
	*) ARGS+=("$1"); shift ;;
	esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

SRC=$(repo_root "${1:-$PWD}")
NAME=$(tree_name "$SRC")

# Captured to a variable rather than eval'd inline so the reader's non-zero
# exit code reaches `set -e`. An `eval $(...)` of an empty string returns 0,
# so the manifest's refusal would otherwise reach the next access to a TASK_*
# variable as a "unbound variable" shell error pointing at the bash line, not
# at the manifest field that is missing.
output=$(python3 "$LIB/manifest.py" "$SRC" --task "$TASK")
eval "$output"
[ "$FULL" = 1 ] && [ -n "$TASK_FULL_COMMAND" ] && TASK_COMMAND=$TASK_FULL_COMMAND
TASK_TIMEOUT=${TASK_TIMEOUT:-3600}

# Two locks, one per contended resource.
#
# The remote lock serialises the reaping below, which removes directories a
# concurrent run may be about to build in, and the one database container every
# tree resets. It is remote because runs reach a host from more than one agent.
#
# The local lock guards the hypervisors: builders are the largest guests on
# memory-overcommitted nodes, so builds on two different hosts can still exhaust
# one memory pool. A lane with its own LANE_POOL has its own lock. It is taken
# before the host is resolved, because with BUILDER_LANES the lock that comes
# free decides the host.
if [ -z "${REMOTE_LANE:-}" ] && [ -n "${BUILDER_LANES:-}" ] && [ "$TASK_ROLE" = builder ]; then
	picked=0
	pick_builder_lane "$NAME" || picked=$?
	if [ "$picked" -ne 0 ]; then
		if [ "$picked" -eq 1 ]; then
			FAIL_REASON="timed out after ${LOCK_WAIT}s with every lane in BUILDER_LANES busy"
		else
			FAIL_REASON="cannot open local lock $BUILD_LOCK"
		fi
		echo "remote-task: $FAIL_REASON" >&2
		exit 1
	fi
else
	BUILD_LOCK=$(lock_for)
	mkdir -p "$(dirname "$BUILD_LOCK")"
	exec {lockfd}>"$BUILD_LOCK"
	if ! flock -w "$LOCK_WAIT" "$lockfd"; then
		FAIL_REASON="timed out after ${LOCK_WAIT}s waiting on local lock $BUILD_LOCK"
		echo "remote-task: $FAIL_REASON" >&2
		exit 1
	fi
fi
REMOTE=$(host_for "$TASK_ROLE")
if [ -n "${REMOTE_LANE:-}" ]; then
	echo "==> lane ${REMOTE_LANE}: host=$REMOTE lock=$BUILD_LOCK"
fi

DB_ENV=""
if [ -n "$TASK_DB_CONTAINER" ]; then
	DB="${TASK_DB_PREFIX}_$NAME"
fi

DEST="bench/$NAME"

echo "==> syncing $SRC to $REMOTE:$DEST"
ssh "$REMOTE" "mkdir -p $DEST"

# `sqlx::migrate!` embeds the migrations at compile time and stable cargo
# registers no rerun-if-changed for them, so the warm `target/` this tool keeps
# carries whichever set was in effect when the crate last compiled. A rebase that
# adds migrations goes on applying the old one, and the gate fails naming a table
# the diff never mentions. Caught here, where the staleness is created.
#
# Compare against the last successful build, not the last transfer. Discover
# embedding sites even without a manifest list; declared sources add custom
# sites without suppressing any discovered ones.
MIGRATOR_FP=""
MIGRATOR_STALE=0
if [ -d "$SRC/$TASK_MIGRATOR_DIR" ]; then
	output=$(python3 "$LIB/migrator.py" "$SRC" "$TASK_MIGRATOR_DIR" "${TASK_MIGRATOR_SOURCES[@]}")
	eval "$output"
	MIGRATOR_FP=$(cd "$SRC" && find "$TASK_MIGRATOR_DIR" -type f -print0 \
		| sort -z | xargs -0 sha256sum 2>/dev/null \
		| sha256sum | awk '{print $1}')
	# Version the sentinel so pre-discovery caches cannot look verified. A
	# different command or source set must invalidate too: tasks share a cache
	# but a successful command may compile only some of the embedding sites.
	MIGRATOR_FP=$(printf '%s\0' "guard-v2" "$MIGRATOR_FP" "$TASK_COMMAND" "${TASK_MIGRATOR_SOURCES[@]}" | sha256sum | awk '{print $1}')
	REMOTE_FP=$(ssh "$REMOTE" "cat $DEST/.migrations-fingerprint 2>/dev/null" || true)
	# A missing sentinel can mean an old warm cache adopting this guard.
	[ "$REMOTE_FP" != "$MIGRATOR_FP" ] && MIGRATOR_STALE=1
	if [ "$MIGRATOR_STALE" = 1 ] && [ ${#TASK_MIGRATOR_SOURCES[@]} -eq 0 ]; then
		echo "migration guard: $TASK_MIGRATOR_DIR changed or has no verified fingerprint, but no embedding sources were found; declare [task.migrator].sources for custom embedding" >&2
		exit 1
	fi
fi

# Exclude the fingerprint sentinel the same way target/ is excluded: the
# file lives on the remote as a side-effect of this tool's own bookkeeping
# and is not part of the source tree.
rsync -a --delete --exclude 'target/' --exclude '.git/' --exclude 'node_modules/' \
	--exclude '.migrations-fingerprint' \
	"$SRC/" "$REMOTE:$DEST/"

# After the sync, not before it. `rsync -a` preserves the source's mtimes, so a
# touch applied to the remote copy beforehand is reverted by the very transfer
# it was meant to survive -- the file lands with its original timestamp, older
# than the artifacts in the warm target/, and cargo rebuilds nothing.
if [ "$MIGRATOR_STALE" = 1 ]; then
	touch_args=""
	sep=""
	for src in "${TASK_MIGRATOR_SOURCES[@]}"; do
		quoted=$(python3 -c 'import shlex, sys; print(shlex.quote(sys.argv[1]))' "$DEST/$src")
		touch_args="$touch_args$sep$quoted"
		sep=" "
	done
	echo "==> migrations changed or unverified; touching ${#TASK_MIGRATOR_SOURCES[@]} source(s) that hold a Migrator"
	ssh "$REMOTE" "touch $touch_args"
fi

if [ -n "$TASK_DB_CONTAINER" ]; then
	echo "==> resetting database $DB"
	ssh "$REMOTE" "docker exec -i $TASK_DB_CONTAINER psql -U $TASK_DB_USER -d postgres -v ON_ERROR_STOP=1 \
		-c 'DROP DATABASE IF EXISTS $DB WITH (FORCE)' -c 'CREATE DATABASE $DB'"
	DB_ENV="export DATABASE_URL=postgres://$TASK_DB_USER@localhost:$TASK_DB_PORT/$DB"
fi

# How many build caches the host keeps, this run's own included. A number
# rather than an age, because the disk is spent by how many exist. It is an
# override rather than a constant since the right value is a property of the
# builder's disk, which this tool cannot see.
KEEP_CACHES=${REMOTE_TASK_KEEP_CACHES:-6}

# `ssh -tt` (a tty) would echo the script and merge stderr -- wrong answer here.
# CALLER must be escaped so the builder's shell expands $PPID, not ours.
# `timeout` puts the build in its own pgrp; `-k 30` hard-kills a TERM-eater.
#
# Backgrounded, because bash runs a trap only once a foreground child returns:
# a TERM, INT or HUP on the wrapper alone would leave ssh connected, so the
# remote watchdog keeps seeing a caller and the build holds the bench lock
# until its own timeout. The trap kills ssh, then re-raises the signal so the
# EXIT trap reports the run as interrupted.
SSH_PID=
forward_signal() {
	local sig=$1
	if [ -n "$SSH_PID" ] && kill -0 "$SSH_PID" 2>/dev/null; then
		kill -KILL "$SSH_PID" 2>/dev/null || true
		wait "$SSH_PID" 2>/dev/null || true
	fi
	trap - "$sig"
	kill -"$sig" "$$" 2>/dev/null || true
}
trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT
trap 'forward_signal HUP' HUP
# `exec` keeps $! as ssh's PID (the subshell execs ssh). Without it, the
# subshell is a bash that forks ssh as a grandchild, and $! is the bash --
# killing it leaves ssh running.
{
exec ssh "$REMOTE" "CALLER=\$PPID flock -w $LOCK_WAIT -E 75 \$HOME/bench/.lock timeout -k 30 $TASK_TIMEOUT bash -euo pipefail -s" <<REMOTE_SCRIPT
# Caller guard: refuse to run if the ssh that queued us is gone.
kill -0 "\$CALLER" 2>/dev/null || { echo "remote-task: caller gone before the lock; not running" >&2; exit 125; }
# Watchdog: TERM the build's pgrp when the caller disappears.
( while kill -0 "\$CALLER" 2>/dev/null; do sleep 5; done; kill -TERM 0 2>/dev/null || true ) &
WD=\$!
trap 'kill "\$WD" 2>/dev/null || true' EXIT
export PATH=$REMOTE_PATH

# Each tree keeps its own build cache and the sync excludes it, so nothing ever
# removed one: a builder accumulated a cache per branch ever benched until a
# compile died on ENOSPC, which reads as a broken build rather than a full
# disk. Reaped by recency, because what bounds the disk is how many caches
# exist and not how old any one of them is.
#
# Inside the lock, so a concurrent run cannot lose the cache it is about to
# use, and ahead of the build, so the space is free when this run needs it.
# The tree being built is excluded by name rather than by its rank in the
# listing: its own cache is stale by mtime whenever anything else was benched
# more recently, and reaping it would make every run cold.
#
# A reaped tree pays one cold rebuild. That is the cost this trades against
# losing the host, and the trees here are the same workspace at different
# commits, so the rebuild is one it was going to pay for its own diff anyway.
stale=\$( { ls -dt \$HOME/bench/*/target 2>/dev/null || true; } \
	| grep -v "^\$HOME/bench/$NAME/target\$" \
	| tail -n +$KEEP_CACHES || true )
if [ -n "\$stale" ]; then
	printf '%s\n' "\$stale" | while read -r dir; do
		echo "==> reaping \$dir"
		rm -rf "\$dir"
	done
fi

cd $DEST
$DB_ENV
$TASK_COMMAND
REMOTE_SCRIPT
} &
SSH_PID=$!
wait "$SSH_PID"

# A failed build must retry invalidation: the next rsync restores local mtimes.
# Advance the sentinel only after the command succeeds, so failure cannot mark
# a stale cache as verified.
if [ -n "$MIGRATOR_FP" ]; then
	ssh "$REMOTE" "printf '%s\n' '$MIGRATOR_FP' > $DEST/.migrations-fingerprint"
fi

# A build resolves dependencies where it runs, which is not where the commit is
# made: a lock file updated remotely and never copied back leaves the branch
# claiming a dependency set it does not have.
for f in ${TASK_FETCH[@]+"${TASK_FETCH[@]}"}; do
	echo "==> fetching $f"
	# Trailing slash on both sides or rsync nests a directory inside itself.
	if [ -d "$SRC/$f" ]; then
		rsync -a --delete "$REMOTE:$DEST/$f/" "$SRC/$f/"
	else
		rsync -a "$REMOTE:$DEST/$f" "$SRC/$f"
	fi
done

# Drift report between the command that just ran and the CI job it mirrors.
# Before the final verdict: a failed build is already red, and the report is
# about a run that succeeded. The tool is advisory -- exit 0 whatever it
# finds, and a task without [task.mirrors] exits silently before printing --
# so a project that has not opted in sees no change. The guard keeps the
# report from failing a run where the tool is not on PATH yet: a missing
# drift report is not a failed build.
if command -v task-mirror-check >/dev/null 2>&1; then
	task-mirror-check "$SRC" --task "$TASK" || true
else
	echo "==> task-mirror-check not on PATH: skipping drift report"
fi

# Must stay the last statement: verdict reads it as "the run finished".
REMOTE_TASK_DONE=1
