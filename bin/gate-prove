#!/usr/bin/env bash
# Check that a branch's new tests actually exercise its change.
#
# This answers one question: would these tests still pass without this diff? It
# does not answer whether the diff is right. A wrong fix and its test fail
# together when reverted, and land here as a pass.
#
# Reverts the source and keeps the tests, then runs them and requires a
# failure. A test that passes without the fix is not a test, and it is the
# failure mode that survives every other gate: the compiler is happy, the suite
# is green, and the assertion encodes the bug.
#
# Seen twice in one night. A pagination fix capped offsets at 500 and shipped
# two tests asserting exactly that. A readiness fix pointed its "healthy" pool
# at the same dead address as the broken one, so it passed against the
# unmodified handler.
#
# Inline tests cannot be checked this way: they live in the file being
# reverted, so reverting takes the test with it. The manifest names the marker
# that identifies one, and those files are reported rather than silently
# counted as covered.
#
# The suite runs twice on every proof, once before the revert and once after.
# The verdict is the comparison, not the second exit code: a build that fails
# before any test executes -- a regenerated offline cache the revert removes, a
# renamed recipe -- is indistinguishable from a fired assertion by status alone,
# and reading it as proof is how this gate reports what it never measured.
#
# Exit codes: 0 the tests depend on the change, 1 they do not, 2 misuse,
# 3 unprovable.
set -euo pipefail

# readlink -f, not `cd -P`: these are installed as symlinks into a bin
# directory on PATH, and BASH_SOURCE holds the symlink's own path. `cd -P`
# resolves symlinks inside the path it is given, not the script's location, so
# ../lib resolved against the link and landed outside the checkout.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

# Falls through to the base gate-verify selected this gate with, so the tests it
# counted and the sources this reverts are the same set. PROVE_BASE overrides it
# for a deliberate re-run against an earlier commit.
BASE=${PROVE_BASE:-${VERIFY_BASE:-origin/main}}

usage() { echo "usage: gate-prove <worktree> [-- test command]" >&2; exit 2; }
[ $# -ge 1 ] || usage
SRC=$(cd "$1" && git rev-parse --show-toplevel)
shift
[ "${1:-}" = "--" ] && shift

cd "$SRC"
git rev-parse --verify --quiet "$BASE" >/dev/null || { echo "no such ref: $BASE" >&2; exit 2; }

mapfile -t CHANGED < <(git diff --name-only "$BASE"...HEAD)
[ ${#CHANGED[@]} -gt 0 ] || { echo "no changes against $BASE" >&2; exit 2; }

TEST_RE=$(manifest "$SRC" prove.tests)
SOURCE_RE=$(manifest "$SRC" prove.sources)
INLINE_RE=$(manifest "$SRC" prove.inline-marker "")

# Tests are matched first: a file under tests/ that also matches the source
# pattern is a test, or reverting it would delete the evidence.
TESTS=() SOURCES=() INLINE=()
for f in "${CHANGED[@]}"; do
	if printf '%s' "$f" | grep -qE "$TEST_RE"; then
		TESTS+=("$f")
	elif printf '%s' "$f" | grep -qE "$SOURCE_RE"; then
		SOURCES+=("$f")
		# A reverted file takes its own tests with it, so a change that adds
		# both a fix and an inline test cannot be split.
		if [ -n "$INLINE_RE" ] && git show "HEAD:$f" 2>/dev/null | grep -qE "$INLINE_RE"; then
			INLINE+=("$f")
		fi
	fi
done

if [ ${#TESTS[@]} -eq 0 ]; then
	echo "FAIL: no test file changed against $BASE" >&2
	[ ${#INLINE[@]} -gt 0 ] && printf '  inline tests only, cannot be proven: %s\n' "${INLINE[@]}" >&2
	exit 1
fi
# Tests with no source to revert -- a Rust test of a fixture another part of
# the change produced -- are unprovable, not a failure: the gate never measured
# whether they depend on the change.
if [ ${#SOURCES[@]} -eq 0 ]; then
	OTHERS=()
	for f in "${CHANGED[@]}"; do
		for t in "${TESTS[@]}"; do [ "$f" = "$t" ] && continue 2; done
		OTHERS+=("$f")
	done
	echo "UNPROVABLE: tests changed but no source did; nothing to revert" >&2
	if [ ${#OTHERS[@]} -eq 0 ]; then
		echo "            no other file changed" >&2
	else
		printf '            non-test files: %s\n' "${OTHERS[@]}" >&2
	fi
	exit 3
fi

# Whether the revert would change anything is a question about two commits, so
# it is answered before anything is executed. A branch whose change reached the
# base by another route while it sat has nothing to revert, and neither verdict
# is true of it: calling it a failure blames tests that are fine, and calling it
# a pass claims evidence that was never gathered. Asking first also keeps the
# suite below out of a case it cannot measure.
if git diff --quiet "$BASE" HEAD -- "${SOURCES[@]}"; then
	echo "UNPROVABLE: source already matches $BASE, so there is nothing to revert." >&2
	echo "            Re-run against an earlier base to prove these tests," >&2
	echo "            e.g. PROVE_BASE=HEAD~1." >&2
	exit 3
fi

# The prove runs in a scratch worktree at HEAD, never in the caller's tree: a
# killed run used to leave the caller half-reverted, since a SIGKILL runs no
# trap and bash defers a trapped signal until the foreground command ends.
# Nothing here writes the caller's tree, so uncommitted work there is safe.
#
# The scratch is named `<caller>-prove` because remote-task names the builder
# tree and database after the path's basename: one shared name would let
# concurrent proves destroy each other's database, and a per-branch name keeps
# each branch's build cache warm.
SCRATCH_PARENT=$(mktemp -d -t gate-prove.XXXXXX) || { echo "mktemp failed" >&2; exit 2; }
# The only path cleanup may delete: compared by equality, so a bug pointing
# cleanup elsewhere is refused.
SCRATCH_PARENT_OWNED=$SCRATCH_PARENT
SCRATCH="$SCRATCH_PARENT/$(basename "$SRC")-prove"
# A run killed with SIGKILL leaves its scratch registered in the caller's
# repository; prune it before adding another.
git -C "$SRC" worktree prune
git -C "$SRC" worktree add --detach "$SCRATCH" HEAD >/dev/null

# Cleanup on every exit the shell still owns. It deletes only the exact
# directory mktemp returned: a glob under $TMPDIR would become `/*` with TMPDIR
# unset.
cleanup() {
	if [ -n "${SCRATCH_PARENT:-}" ] && [ -d "$SCRATCH_PARENT" ] \
			&& [ "$SCRATCH_PARENT" = "${SCRATCH_PARENT_OWNED:-}" ]; then
		if [ -n "${SCRATCH:-}" ] && [ -d "$SCRATCH" ]; then
			git -C "$SRC" worktree remove --force "$SCRATCH" 2>/dev/null || true
		fi
		rm -rf "$SCRATCH_PARENT"
	fi
}
trap cleanup EXIT TERM INT HUP

# One definition for both runs, since the verdict compares them. A caller's
# override runs inside the scratch too: run where it was called, it would test
# the caller's unreverted tree and report a proof that never saw the revert.
run_suite() {
	if [ $# -gt 0 ]; then
		# (cd ... && "$@") so the override sees the scratch's tree, not
		# the caller's: the manifest path runs (cd "$SCRATCH" && eval ...)
		# for the same reason.
		(cd "$SCRATCH" && "$@")
	else
		# The project's own suite, so what proves a test here is what runs in CI.
		(cd "$SCRATCH" && eval "$(manifest "$SCRATCH" prove.command)")
	fi
}

# The suite on the unmodified scratch. The verdict compares against this run,
# so a build that fails for reasons unrelated to the tests is not mistaken for
# a proof.
set +e
run_suite "$@"
pre_rc=$?
set -e

if [ "$pre_rc" -eq 126 ] || [ "$pre_rc" -eq 127 ]; then
	echo
	echo "UNPROVABLE: the test command did not run (exit $pre_rc)." >&2
	echo "            Nothing was measured, so this is neither a pass nor a failure." >&2
	exit 3
fi
if [ "$pre_rc" -ne 0 ]; then
	echo
	echo "UNPROVABLE: the suite fails on the unmodified tree (exit $pre_rc)." >&2
	echo "            The branch is already red, so a failure after the revert" >&2
	echo "            would say nothing about these tests." >&2
	exit 3
fi

printf '==> reverting %d source file(s), keeping %d test file(s)\n' "${#SOURCES[@]}" "${#TESTS[@]}"
# A file the branch adds has no version at BASE, so reverting it means deleting
# it from the scratch.
for f in "${SOURCES[@]}"; do
	if git -C "$SCRATCH" show "$BASE:$f" >/dev/null 2>&1; then
		git -C "$SCRATCH" checkout --quiet "$BASE" -- "$f"
	else
		rm -f "$SCRATCH/$f"
		git -C "$SCRATCH" rm --quiet --cached "$f" 2>/dev/null || true
	fi
done

set +e
run_suite "$@"
rc=$?
set -e

if [ $rc -eq 0 ]; then
	echo
	echo "FAIL: the suite passes with the change reverted." >&2
	echo "      The new tests do not distinguish the fix from the bug." >&2
	exit 1
fi

# A suite that could not start also exits non-zero, and counting that as proof
# is the one way this gate can report a result it did not measure. 127 and 126
# are the shell saying the command is missing or not executable -- an absent
# toolchain, a recipe that was renamed.
#
# It does not catch every such case: a suite that fails to compile is
# indistinguishable here from one whose assertion fired, and both exit 1. What
# makes the result trustworthy is the pre-run: the same command passed on the
# unmodified tree moments earlier, so something the revert did is what changed.
if [ $rc -eq 127 ] || [ $rc -eq 126 ]; then
	echo
	echo "UNPROVABLE: the test command did not run (exit $rc)." >&2
	echo "            Nothing was measured, so this is neither a pass nor a failure." >&2
	exit 3
fi

echo
# Deliberately not "proven": what this establishes is that the tests depend on
# the change, which is a fact about the tests. A broken fix passes here too --
# reverting it still makes its test fail. Nothing about correctness is measured.
echo "==> the tests depend on the change: the suite fails without it (exit $rc)"
[ ${#INLINE[@]} -gt 0 ] && printf '    note: inline tests in %s were reverted too and are not covered\n' "${INLINE[@]}"
exit 0
