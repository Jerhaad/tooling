#!/usr/bin/env bash
# Run the compose migrate path on ai-serv, the way ci.yaml's Schema & Seeds job
# does.
#
# hypatia-bench builds the image straight from Dockerfile.api, so it says
# nothing about whether compose can still find and run that image. Anything that
# changes how the migrate service gets its image -- an `image:` key, a
# pre-built tag, `--no-build` -- is invisible to every other gate on this host
# and shows up only once CI runs.
set -euo pipefail

# Host addresses belong to whoever runs this, not to the scripts. Set them in
# ~/.config/hermes-tools/env (see hosts.env.example); sourced here rather than
# left to the shell profile so cron jobs and agent subprocesses get them too.
ENV_FILE=${HERMES_TOOLS_ENV:-$HOME/.config/hermes-tools/env}
# An if, not `[ -r ] &&`: under `set -e` the && chain returns 1 when the file is
# absent and takes the whole script with it.
if [ -r "$ENV_FILE" ]; then
	# shellcheck source=/dev/null
	. "$ENV_FILE"
fi

REMOTE=${AI_SERV_SSH:?set AI_SERV_SSH to an ssh target for the build host: a Rust toolchain, docker and postgres}

SRC=$(cd "${1:-$PWD}" && git rev-parse --show-toplevel)
# Same derivation as hypatia-bench, so the two share one remote directory and a
# warm target/ rather than syncing the tree twice.
NAME=$(basename "$SRC" | tr -c 'A-Za-z0-9_' '_' | tr -s '_' | sed 's/_$//')
DEST="bench/$NAME"

ssh "$REMOTE" "mkdir -p $DEST"
rsync -a --delete --exclude 'target/' --exclude '.git/' --exclude 'node_modules/' \
	"$SRC/" "$REMOTE:$DEST/"

# Run the command ci.yaml runs, read out of ci.yaml, rather than a copy of it
# kept here. A copy passes while the workflow fails: `--no-build` reached CI as
# a global flag rather than an option of `up`, and this check -- running its own
# spelling of the command -- reported the compose path healthy anyway.
# Anchored on `docker compose` and the migrate invocation, with everything
# between left open: global flags precede -f, so pinning -f as the first
# argument makes the extractor reject a command it should have run.
COMPOSE_CMD=$(sed -n 's/^[[:space:]]*\(docker compose .*--exit-code-from migrate migrate\)[[:space:]]*$/\1/p' \
	"$SRC/.github/workflows/ci.yaml" | head -1)
if [ -z "$COMPOSE_CMD" ]; then
	echo "could not find the migrate command in .github/workflows/ci.yaml" >&2
	exit 1
fi
echo "==> from ci.yaml: $COMPOSE_CMD"

# down -v first: the assertions that follow this job in CI read a schema built
# from empty, and a volume surviving from the last run hides a migration that
# only applies to a fresh database.
#
# Torn down with the same file set the run uses, derived from the command read
# out of ci.yaml. Naming the base file alone stopped working the moment that
# file grew `:?` guards -- it refuses without an --env-file, `|| true` swallowed
# the refusal, and the volume it was supposed to drop survived every run.
#
# The build is separate because CI builds the image in its own step; running the
# compose command with nothing built would only ever test the fallback.
ssh "$REMOTE" "bash -euo pipefail -s" <<EOF
cd $DEST
${COMPOSE_CMD% up*} down -v >/dev/null 2>&1 || true
docker build -f docker/Dockerfile.api -t hypatia-api:latest . >/dev/null
$COMPOSE_CMD
${COMPOSE_CMD% up*} down -v >/dev/null 2>&1 || true
EOF

echo "==> compose migrate path OK ($NAME)"
