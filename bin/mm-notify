#!/bin/bash
# Send a message to Telegram. Reads credentials from the shared env file.
set -uo pipefail

CONF="${MM_MONITOR_ENV:-$HOME/.config/mm-monitor/env}"
if [ ! -r "$CONF" ]; then
	echo "mm-notify: no readable config at $CONF" >&2
	exit 1
fi
# shellcheck source=/dev/null
. "$CONF"

: "${TELEGRAM_BOT_TOKEN:?mm-notify: TELEGRAM_BOT_TOKEN unset}"
: "${TELEGRAM_CHAT_ID:?mm-notify: TELEGRAM_CHAT_ID unset}"

text="${1:?mm-notify: message required}"

# Telegram only accepts the bot token in the URL path, never as a field.
code=$(curl -sS --max-time 20 -o /tmp/mm-notify.out -w '%{http_code}' \
	--data-urlencode "text=${text}" \
	--data "chat_id=${TELEGRAM_CHAT_ID}" \
	--data "parse_mode=HTML" \
	--data "disable_web_page_preview=true" \
	"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" 2>/dev/null) || true

if [ "$code" != "200" ]; then
	echo "mm-notify: telegram returned ${code:-no response}: $(head -c 300 /tmp/mm-notify.out 2>/dev/null)" >&2
	rm -f /tmp/mm-notify.out
	exit 1
fi
rm -f /tmp/mm-notify.out
