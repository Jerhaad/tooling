# Copy to ~/.config/agent-tools/env and fill in. Every tool sources that file
# directly, so cron jobs and agent subprocesses get the values without
# depending on an interactive shell profile.
#
# Nothing in this repository may carry a real address: these name one operator's
# private network, and a tool that hardcodes them is a tool only that operator
# can run.
#
# A host is named for what it can do, never for what it is called. A project
# asks for a `builder`; whether that resolves to a rack server, a spare desktop
# or a cloud instance is nobody's business but yours. `HOST_<ROLE>` is the whole
# convention -- add a role by exporting one.
#
# The specs below are what each role was developed against, not a requirement.
# They are here so you can judge whether a machine you have is in the right
# class before finding out through a six-hour timeout.

# builder -- a capable server or workstation that runs tests, builds and other
# jobs on demand. Needs the project's toolchain, docker, and enough disk for a
# build cache that persists between runs.
#   Developed against: 8 vCPU, 32 GB RAM, 200 GB SSD, Linux.
#   Undersized shows up as a build cache thrashing rather than an outright
#   failure, so give it more disk than the source tree suggests.
export HOST_BUILDER=user@build-host

# cluster -- a machine holding the deployment toolchain: helm, terraform,
# kubectl and credentials for whatever they talk to. Usually small; it templates
# and validates, it does not compile.
#   Developed against: 4 vCPU, 8 GB RAM, Linux, no docker and no rsync -- which
#   is why the transport to this role is tar over ssh.
export HOST_CLUSTER=user@cluster-host

# An OpenAI-compatible chat-completions endpoint used to grade and route issues
# by size. The work is comparing short strings, so the smallest model you have
# is the right one; a large or metered model here buys nothing.
#   Developed against: a 20 GiB local model serving 64K context on a 32 GB box.
#   Context length is the constraint that matters -- grading reads issue text,
#   and a short window silently truncates the issues it is meant to compare.
export GRADER_URL=http://model-host:8080/v1/chat/completions

# Default repository for tools that take --repo, as owner/name. Falls back to
# the current checkout's origin remote when unset.
export DEFAULT_GH_REPO=owner/name
