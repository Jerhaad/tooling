# Copy to ~/.config/hermes-tools/env and fill in. Every tool here sources that
# file directly, so cron jobs and agent subprocesses get the values without
# depending on an interactive shell profile.
#
# Nothing in this repository may carry a real address: these name one person's
# private network, and a tool that hardcodes them is a tool only that person
# can run.

# Build host. Needs a Rust toolchain, docker, and a postgres container the
# bench resets per branch. Read by hypatia-bench, -sqlx-prepare,
# -compose-check, -explain.
export AI_SERV_SSH=user@build-host

# Cluster host. Needs helm and terraform on its PATH. Read by
# hypatia-chart-check and hypatia-tf-check.
export KUBEADM_SSH=user@cluster-host

# OpenAI-compatible chat-completions endpoint used for issue grading.
export ATHENS_URL=http://model-host:8080/v1/chat/completions

# Default repository for tools that take --repo. Falls back to the current
# checkout's origin remote when unset.
export HYPATIA_REPO=owner/name
