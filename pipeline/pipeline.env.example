# Copy to ~/.config/agent-pipeline/env and fill in. Every phase sources it, so
# cron jobs and agent subprocesses get the values without an interactive shell.
#
# Nothing in this repository may carry a real path or project name: these name
# one person's machine, and a phase that hardcodes them is a phase only that
# person can run.

# The checkout the phases read and branch from. Never modified in place.
export PIPELINE_REPO=$HOME/src/yourproject
# owner/name, for gh.
export PIPELINE_GH_REPO=owner/yourproject

# A second checkout the review phase may reset --hard and clean -ffd on every
# run. It must not be the one above, and it must not be one you work in.
export PIPELINE_REVIEW_WORK=$HOME/src/yourproject-review

# The gate: one command taking a worktree path, non-zero when the tree is not
# fit to push. Everything the pipeline claims about correctness comes from this,
# so it should be the same command your CI runs.
export PIPELINE_VERIFY="$HOME/bin/your-verify"

# The agent CLI, invoked as: $PIPELINE_AGENT [-p LANE] -z "<prompt>" --skills X
export PIPELINE_AGENT="$HOME/.local/bin/your-agent"
# The driver that implements one issue on a branch, and the one that triages.
export PIPELINE_IMPLEMENTER="$HOME/bin/your-implementer"
export PIPELINE_TRIAGER="$HOME/bin/your-triager"
export PIPELINE_BRANCH_SWEEP="$HOME/bin/your-branch-sweep"

# Which labels the implement phase will take. It only dispatches work its gate
# can check, so this is the set the gate covers -- widen it when the gate does.
export PIPELINE_AREAS='area:rust|area:db|area:ci'
# Which directory means which label, for issues filed from findings.
export PIPELINE_AREA_LABELS='src/=area:code,migrations/=area:db,.github/=area:ci'

# Dedup judge. Filing an issue per finding needs to recognise a finding it has
# already filed, and the reviewer rewrites what it carries forward -- so the
# same defect arrives worded differently each night. Fingerprints and word
# overlap settle the obvious cases for free; this is asked only about the
# suspicious middle.
#
# The contract is one argument in, one line out. It receives a prompt naming a
# new finding and a numbered list of existing issues, and must print either the
# number of the issue that is the same finding, or NONE.
#
# A small, fast model is the right size. It compares two sentences, it never
# sees code, and the prompt is a few hundred tokens -- spending a large or
# metered model here buys nothing. Unset means mechanical matching only, which
# files a duplicate when the wording drifts far enough.
#
# export PIPELINE_DEDUP_JUDGE="$HOME/bin/your-judge"
# export PIPELINE_DEDUP_TIMEOUT=180

# Optional, with defaults.
# export PIPELINE_QUEUE=$HOME/.local/share/agent-pipeline/queue
# export PIPELINE_WT_ROOT=$HOME/wt
# export PIPELINE_STATE_DIR=$HOME/.local/state/agent-pipeline
# export PIPELINE_BRANCH_PREFIX=issue-
# export PIPELINE_STALE_DAYS=3
# export PIPELINE_RESUME_MAX=2
# export PIPELINE_LOCK=/tmp/agent-pipeline.lock

# Project facts the agent needs and cannot infer -- what the gate cannot run
# locally, what must be regenerated after a change. Passed through verbatim.
# export PIPELINE_AGENT_NOTES="Regenerate the query cache with ... after editing SQL."
